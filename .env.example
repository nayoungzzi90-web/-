# 브라우저에 노출되는 값만 VITE_ 접두사로 둔다. service_role 키·PG Secret·AI API 키는 절대 여기에 넣지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 기능 플래그 (기본 OFF). 법률/계약 검증이 끝나기 전 true로 바꾸지 말 것.
VITE_FLAG_COMPAT_ENABLED=false
VITE_FLAG_LIVE_PAYMENT=false
VITE_FLAG_LLM_REPORTS=false
# public/characters/{gap,eul,byeong,jeong,mu,gi,gyeong,sin,im,gye}.webp 독자 제작 에셋을 넣은 뒤 true
VITE_CHARACTER_ASSETS=false
# 운영 지표 화면의 비밀 주소(기본값 대신 추측하기 어려운 값으로 바꾸세요). 인증이 아니라 편의용이며 검색 노출만 막아요.
VITE_OPS_PATH=ops-ohaeng-x9k2

# ── Edge Function(서버) 전용 비밀값: 절대 VITE_ 접두사로 두거나 브라우저에 노출하지 말 것 ──
# supabase secrets set LLM_PROVIDER=openai OPENAI_API_KEY=... LLM_MODEL=<공식 모델 목록의 모델명>   # Claude 를 쓰려면 LLM_PROVIDER=anthropic ANTHROPIC_API_KEY=... LLM_MODEL=claude-opus-5-5 LLM_EFFORT=medium ALLOWED_ORIGIN=https://내도메인

# ── AI 비용 안전장치(필수, 없으면 생성 시작 안 함) — supabase secrets set 으로 서버에만 ──
# LLM_PRICE_IN_PER_M=<모델 공식 입력 가격 USD/100만 토큰>  LLM_PRICE_OUT_PER_M=<출력 가격>  (선택) LLM_PRICE_CACHED_IN_PER_M=<캐시 입력 가격>
# LLM_REPORT_BUDGET_USD=<리포트 1건 원가 상한>  (선택) LLM_REPORT_BUDGET_USD_BASIC / LLM_REPORT_BUDGET_USD_LOVE_DEEP
# LLM_DAILY_BUDGET_USD=<하루(한국 시간) 전체 원가 상한>   (선택) LLM_MAX_INPUT_TOKENS=40000 LLM_MAX_OUTPUT_TOKENS=4000 LLM_TOKENS_PER_CHAR=1.5
# LLM_KILL_SWITCH=true  → 모든 AI 생성을 즉시 중단(코드 배포 없이)
